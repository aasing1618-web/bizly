# ---------------------------------------------------------------------------
# Bizly — variables d'environnement
#
# Copier ce fichier en `.env` et remplir les valeurs.
# `.env` est ignoré par git : aucune valeur réelle ne doit apparaître ICI.
# ---------------------------------------------------------------------------

# Environnement d'exécution : development | test | production
NODE_ENV=development

# Port HTTP du processus unique (API + admin + app cliente)
PORT=3000

# ---------------------------------------------------------------------------
# Base de données Supabase — POOLER, PORT 6543 (mode transaction)
#
# Où la trouver :
#   Dashboard Supabase → ton projet → Connect (bouton en haut)
#   → onglet "Connection string" → "Transaction pooler"
#   → copier l'URI, remplacer [YOUR-PASSWORD] par le mot de passe de la base.
#
# La chaîne ressemble à :
#   postgresql://postgres.<ref-projet>:<mot-de-passe>@aws-0-<region>.pooler.supabase.com:6543/postgres
#
# Vérifier deux choses avant de valider :
#   - le port est bien 6543 (pooler), PAS 5432 (connexion directe)
#   - l'hôte contient bien "pooler.supabase.com"
# ---------------------------------------------------------------------------
DATABASE_URL=

# Nombre maximum de connexions du pool applicatif.
# Rester modeste : le pooler Supabase est déjà partagé entre tous tes services.
DATABASE_POOL_MAX=10

# Vérification TLS : require (défaut, recommandé) | no-verify | disable
#   - require   : TLS avec vérification du certificat
#   - no-verify : TLS sans vérification — dépannage seulement, jamais en production
#   - disable   : sans TLS — jamais avec Supabase
DATABASE_SSL=require

# ---------------------------------------------------------------------------
# Certificat racine de Supabase.
#
# Le pooler présente une chaîne signée par « Supabase Root 2021 CA », une
# autorité PRIVÉE que Node ne connaît pas : sans ce fichier, DATABASE_SSL=require
# échoue avec « self-signed certificate in certificate chain ».
#
# Ce certificat est PUBLIC, il est versionné dans le dépôt — rien de sensible.
# Chemin relatif à la racine du projet.
#
# Pour le vérifier : Dashboard Supabase → Project Settings → Database →
# SSL Configuration → « Download certificate », puis comparer l'empreinte
# SHA-256 avec celle affichée par « npm run verifier:tls ».
# ---------------------------------------------------------------------------
DATABASE_CA_CERT=db/supabase-root-2021-ca.crt

# ---------------------------------------------------------------------------
# Déploiement (Vercel ou tout hébergeur sans état)
#
# Ces variables se saisissent dans le panneau d'environnement de l'hébergeur,
# JAMAIS dans un fichier commité (CLAUDE.md §11).
#
#   NODE_ENV=production
#     → active le cookie `Secure` et la confiance au premier proxy.
#       Vercel le pose automatiquement.
#
#   DATABASE_URL=<chaîne du pooler, port 6543>
#     → le mode transaction du pooler est EXACTEMENT ce qu'il faut à un
#       hébergeur sans état : chaque requête emprunte une connexion et la rend.
#
#   DATABASE_POOL_MAX=1
#     → une seule connexion par instance. Plusieurs instances tournent en
#       parallèle : viser 10 chacune saturerait le pooler pour rien.
#
#   DATABASE_CA_CERT=db/supabase-root-2021-ca.crt
#     → le fichier est embarqué dans la fonction (`vercel.json`,
#       `includeFiles`). En cas de doute, cette variable accepte aussi le
#       CONTENU du certificat collé directement.
#
# PORT n'est pas utilisé en mode sans état : l'hébergeur appelle l'application
# comme une fonction, il n'y a pas de port à ouvrir.
#
# Les migrations ne s'appliquent PAS au déploiement : elles se lancent à la
# main depuis un poste (`npm run migrate`), pour qu'un déploiement ne modifie
# jamais le schéma sans qu'on l'ait décidé.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# API Wave Merchant (Checkout API)
#
# Obtenir les clés sur https://business.wave.com/ (ou dashboard Marchand Wave).
# ---------------------------------------------------------------------------
WAVE_API_KEY=
WAVE_WEBHOOK_SECRET=
WAVE_API_URL=https://api.wave.com/v1/checkout/sessions
BIZLY_BASE_URL=http://localhost:3000


# ---------------------------------------------------------------------------
# Abonnement — lien de paiement Wave Business (FACULTATIF)
#
# Un lien de paiement Wave se génère depuis un compte Wave Business ; il ne se
# déduit PAS d'un numéro de téléphone. Laisser vide tant qu'on n'en a pas : le
# client voit alors le numéro 77 860 82 47 et la marche à suivre, ce qui marche
# sans rien configurer. Renseigné, un bouton « Payer avec Wave » apparaît.
WAVE_LIEN_PAIEMENT=
