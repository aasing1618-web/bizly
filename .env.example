# ---------------------------------------------------------------------------
# Bizly — variables d'environnement
#
# Copier ce fichier en `.env` et remplir les valeurs.
# `.env` est ignoré par git : aucune valeur réelle ne doit apparaître ICI.
# ---------------------------------------------------------------------------

# Environnement d'exécution : development | test | production
NODE_ENV=development

# Port HTTP du processus unique (API + admin + app cliente)
PORT=3000

# ---------------------------------------------------------------------------
# Base de données Supabase — POOLER, PORT 6543 (mode transaction)
#
# Où la trouver :
#   Dashboard Supabase → ton projet → Connect (bouton en haut)
#   → onglet "Connection string" → "Transaction pooler"
#   → copier l'URI, remplacer [YOUR-PASSWORD] par le mot de passe de la base.
#
# La chaîne ressemble à :
#   postgresql://postgres.<ref-projet>:<mot-de-passe>@aws-0-<region>.pooler.supabase.com:6543/postgres
#
# Vérifier deux choses avant de valider :
#   - le port est bien 6543 (pooler), PAS 5432 (connexion directe)
#   - l'hôte contient bien "pooler.supabase.com"
# ---------------------------------------------------------------------------
DATABASE_URL=

# Nombre maximum de connexions du pool applicatif.
# Rester modeste : le pooler Supabase est déjà partagé entre tous tes services.
DATABASE_POOL_MAX=10

# Vérification TLS : require (défaut, recommandé) | no-verify | disable
#   - require   : TLS avec vérification du certificat
#   - no-verify : TLS sans vérification — dépannage seulement, jamais en production
#   - disable   : sans TLS — jamais avec Supabase
DATABASE_SSL=require
